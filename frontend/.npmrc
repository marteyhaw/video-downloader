# Pin new installs to exact versions so dependency changes are always intentional.
save-exact=true

# Supply-chain hardening: refuse to install any package version published less
# than 7 days ago (10080 minutes). Gives the ecosystem time to catch malicious
# or broken releases before they can land here. Enforced by pnpm at install time.
minimum-release-age=10080

# Security exception: the vite 8 toolchain bump (vite + its plugin + vitest) was
# taken to clear dev-server CVEs (GHSA-p9ff-h696-f583 et al.)  To be deleted after
# 6/8/26
minimum-release-age-exclude[]=vite
minimum-release-age-exclude[]=vitest
minimum-release-age-exclude[]=@vitejs/*
minimum-release-age-exclude[]=@vitest/*
minimum-release-age-exclude[]=@rolldown/*
minimum-release-age-exclude[]=rolldown
minimum-release-age-exclude[]=@oxc-project/*
# Transitive deps of the vite 8 tree that also shipped < 7 days ago.
minimum-release-age-exclude[]=tinyglobby
