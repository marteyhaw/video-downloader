# Copy to .env and adjust as needed.
# All variables use the VD_ prefix.

# API server
VD_HOST=127.0.0.1
VD_PORT=8000

# Vite dev server (use a dedicated port if another app uses 5173)
VD_DEV_PORT=5175
VD_STRICT_DEV_PORT=true

# Optional comma-separated CORS origins (default: derived from VD_DEV_PORT)
# VD_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Storage
VD_DOWNLOADS_DIR=./downloads
# VD_DATABASE_URL=sqlite+aiosqlite:///path/to/video_downloader.db

# Limits and behavior
# 500 MB	524288000
# 1 GB      1073741824
# 2 GB      2147483648
# 5 GB      5368709120
# 10 GB     10737418240
# 20 GB     21474836480
# 50 GB     53687091200
VD_MAX_FILE_BYTES=5368709120
VD_BLOCK_PRIVATE_IPS=true
VD_SCAN_TIMEOUT_SECONDS=30
VD_SCAN_YTDLP_RETRIES=2
VD_M3U8_FETCH_TIMEOUT_SECONDS=15
VD_YTDLP_CONCURRENT_FRAGMENTS=8
# Browser impersonation for Cloudflare-protected sites (requires curl-cffi via uv sync)
VD_YTDLP_IMPERSONATE_ENABLED=true
VD_YTDLP_IMPERSONATE_TARGET=chrome
# Playwright: click/play lazy-loaded players before capturing network URLs
VD_PLAYWRIGHT_AUTOPLAY_ENABLED=true
VD_PLAYWRIGHT_AUTOPLAY_WAIT_MS=3000
VD_PLAYWRIGHT_CLICK_TIMEOUT_MS=1000
VD_PLAYWRIGHT_AUTOPLAY_ONLY_IF_EMPTY=false
# When the page itself yields no streams, discover embedded video URLs (iframes,
# links, data-attributes) that yt-dlp supports and scan each with yt-dlp
VD_SCAN_EMBEDS=true
VD_MAX_EMBEDS=10
# Optional: gallery/carousel stepping to lazy-load more embeds (adds scan time)
VD_PLAYWRIGHT_GALLERY_STEPPING_ENABLED=false
VD_PLAYWRIGHT_GALLERY_MAX_STEPS=32
VD_PLAYWRIGHT_GALLERY_STEPS_PER_WIDGET=6
VD_PLAYWRIGHT_GALLERY_MAX_WIDGETS=15
VD_PLAYWRIGHT_GALLERY_STEP_WAIT_MS=1200
